node_modules/
artifacts/
*.log
.variants/

# The owner's private deny-list for scripts/privacy-scan.py: one regex per line
# for names that must never be published. Committing it would publish them.
.privacy-denylist

# session state written by require-verification.py
.claude/.bendit-state/
# state other copies of the gate write when they run in this repo (the
# private kit Bendit was extracted from uses .verify-state)
.claude/.verify-state/

# bytecode from the hook scripts, written whenever one imports another
# (the guards import shell_text.py)
__pycache__/

# macOS
.DS_Store

# Eval run output is throwaway, except the index that records it. Frozen eval
# inputs (evals/freezes/) are provenance and stay in git.
plugins/bendit/evals/results/*
!plugins/bendit/evals/results/INDEX.md
# Benchmark output: runs.jsonl is the record; the harness's raw output, the
# per-run config dirs and the empty A0 plugin are throwaway.
plugins/bendit/evals/bench/results/*/raw/
plugins/bendit/evals/bench/results/*/cfg/
plugins/bendit/evals/bench/results/*/null-plugin/

# Planning docs name private projects and paths; they stay local.
docs/superpowers/

# NL2Bash corpus: fetched by plugins/bendit/evals/bench/corpus/fetch_nl2bash.py, not vendored
plugins/bendit/evals/bench/corpus/nl2bash/all.cm

# A2 approval request, present only while an A2 run is in flight
plugins/bendit/evals/bench/.a2-request
